ry"/></mxCell><mxCell id="s39" value="4. memeriksa kelengkapan isian" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="658" y="524" width="302" height="16" as="geometry"/></mxCell><mxCell id="s40" value="[isian lengkap]" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="572" width="350" height="16" as="geometry"/></mxCell><mxCell id="s41" value="5. menampilkan ringkasan pengajuan" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="600" width="350" height="16" as="geometry"/></mxCell><mxCell id="s42" value="[isian tidak lengkap]" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="643" width="350" height="16" as="geometry"/></mxCell><mxCell id="s43" value="menampilkan pesan isian belum lengkap; peminjam diminta&lt;br&gt;melengkapi isian" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="671" width="350" height="32" as="geometry"/></mxCell><mxCell id="s44" value="6. mengirim pengajuan" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="745" width="350" height="16" as="geometry"/></mxCell><mxCell id="s45" value="7. ajukan(): menyimpan pengajuan dengan status Menunggu&lt;br&gt;Keputusan" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="777" width="350" height="32" as="geometry"/></mxCell><mxCell id="s46" value="nomor pengajuan" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="825" width="350" height="16" as="geometry"/></mxCell><mxCell id="s47" value="8. menampilkan nomor pengajuan" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="857" width="350" height="16" as="geometry"/></mxCell><mxCell id="s48" value="[mahasiswa memilih cetak]" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="904" width="350" height="16" as="geometry"/></mxCell><mxCell id="s49" value="9. memilih cetak bukti pengajuan (khusus Mahasiswa, extend&lt;br&gt;LAB-UC05)" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="932" width="350" height="32" as="geometry"/></mxCell><mxCell id="s50" value="10. menampilkan bukti pengajuan dengan nomor pengajuan" style="text;html=1;align=center;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="980" width="350" height="16" as="geometry"/></mxCell><mxCell id="s51" value="extension point: Bukti pengajuan tersedia" style="text;html=1;align=right;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="1014" width="350" height="16" as="geometry"/></mxCell><mxCell id="s52" value="Sequence diagram LAB-UC03 Ajukan Peminjaman (include LAB-UC04, extend LAB-UC05)" style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontFamily=Arial;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="130" y="14" width="800" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>